# Android boot test of the Halium kernel: Android init needs SELinux as the
# active major LSM. halium.config puts apparmor first, which leaves selinuxfs
# unregistered and init aborts in first stage. AppArmor stays built in.
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,selinux,smack,tomoyo,apparmor,bpf"
CONFIG_DEFAULT_SECURITY_SELINUX=y
